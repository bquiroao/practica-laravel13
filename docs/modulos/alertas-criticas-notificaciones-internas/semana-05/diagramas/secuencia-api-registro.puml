@startuml secuencia-api-registro
' Semana 5 - Registro por API: autenticación, permiso, tenant del token y X-Request-Id
autonumber
skinparam ParticipantBackgroundColor #F4F8FF
actor "Laboratorio\n(tok-lab-gua)" as LAB
participant "ApiAlertas" as API
participant "AutenticadorFicticio" as AUT
participant "Permisos" as PER
participant "RegistrarAlertaCritica" as REG
database "AlertaRepository" as REP
LAB -> API : POST /api/v1/alertas\nX-Request-Id: demo-00000001\n{codigo_paciente, servicio, id_origen, prioridad, descripcion}
API -> AUT : identificar(Authorization)
alt token ausente o desconocido
  API --> LAB : 401 no_autenticado + WWW-Authenticate
else válido
  AUT --> API : Identidad(usuario, rol=sistema_origen, tenant=HOSP-GUA-01)
  API -> PER : permite(rol, registrar)
  alt rol sin permiso
    API --> LAB : 403 sin_permiso
  else permitido
    API -> REG : ejecutar(datos + tenant y origen del token)
    REG -> REP : buscarPorOrigen / guardar
    alt duplicado (RN-02)
      API --> LAB : 200 {duplicada: true}
    else regla incumplida (RN-01)
      API --> LAB : 422 {error.regla: RN-01}
    else base caída
      API --> LAB : 503 persistencia_no_disponible
    else nuevo
      API --> LAB : 201 + Location + X-Request-Id: demo-00000001
    end
  end
end
@enduml
