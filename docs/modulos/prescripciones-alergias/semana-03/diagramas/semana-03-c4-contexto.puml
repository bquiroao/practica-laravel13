Rel(medico, presc, "Verifica y emite", "HTTPS/JSON")
Rel(farmacia, presc, "Consulta", "HTTPS/JSON")
Rel(presc, expediente, "Lee alergias activas", "puerto FuenteAlergias; si falla → 503")
Rel(presc, catalogo, "Lee medicamento y grupo", "puerto CatalogoMedicamentos")
Rel(presc, rbac, "Pide decisión", "puerto PoliticaAcceso")
Rel(presc, identidad, "Valida token", "Autenticador")
