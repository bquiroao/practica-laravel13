@startuml
left to right direction
actor "Receptor demo" as U
package Presentation {
 component "CLI / composición" as ROOT
 component ReceptionController as C
 component JsonView as V
}
package "Application existente" {
 component ReceiveSpecimen as UC
 interface SpecimenRepository as R
 interface SpecimenIdentifierGenerator as G
}
package "Domain existente" {
 class ReceptionRequest
 component SpecimenAcceptancePolicy as POL
 class SpecimenReception
}
package Persistence {
 component "InMemoryRepository nuevo" as MEM
 component "PdoSpecimenRepository reutilizado" as PDO
}
database "SQLite temporal / recepción" as DB
U --> ROOT
ROOT --> C
ROOT --> V
C --> ReceptionRequest
C --> UC
UC --> POL
UC --> G
UC --> SpecimenReception
UC --> R
MEM ..|> R
PDO ..|> R
PDO --> DB : INSERT preparado
C --> [Modelo de salida]
[Modelo de salida] --> V
note bottom of C
Forma/tipos y delegación; sin SQL
ni decisión de aceptación/rechazo.
end note
@enduml