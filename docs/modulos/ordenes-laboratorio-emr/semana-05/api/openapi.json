                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sesión de identidad HIS; no se define login ni se presume formato JWT concreto."
      }
    },
    "schemas": {
      "CreateOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCodes"
        ],
        "properties": {
          "testCodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patientId",
          "encounterId",
          "requestedBy",
          "testCodes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "patientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "encounterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "requestedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "testCodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "status": {
            "type": "string",
            "description": "Etiqueta del ciclo acordado con laboratorio. TEST_INITIAL es solo ejemplo.",
            "example": "TEST_INITIAL"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  }
}
