@startuml semana-06-diagrama-trazable
' De actor a prueba: cada decisión tiene evidencia
left to right direction
skinparam rectangleBorderColor #34495E
skinparam rectangleBackgroundColor #F7F9FC
actor "Médico" as MED
actor "Enfermería" as ENF
rectangle "CU-01 Registrar\nCU-02 Validar" as CU1
rectangle "CU-03 Consultar\nCU-04 Calcular" as CU3
rectangle "CU-05 Reconocer" as CU5
rectangle "RF-01, RF-02, RF-03\nRN-01..RN-07" as RF1
rectangle "RF-04, RF-05\nRN-08 · RNF-07 (OCP)" as RF4
rectangle "RF-06, RF-07\nRN-09" as RF6
rectangle "Dominio: Alergia::registrar,\nAlergeno::clave + índice único" as D1
rectangle "Dominio: CalculadorAlerta +\nReglaNivelAlerta (OCP)" as D4
rectangle "Aplicación: ReconocerAlerta\n+ huella" as D6
rectangle "Repository: Pdo* / *EnMemoria\n(contrato C-1..C-5)" as REP
rectangle "POST /api/v1/.../alergias" as API1
rectangle "GET /api/v1/.../alerta" as API4
rectangle "POST /api/v1/.../alerta/reconocimientos" as API6
rectangle "T-01..T-04, T-10, T-11,\nT-37, T-39, T-41" as P1
rectangle "T-05, T-06, T-09, T-35,\nOCP-01..OCP-04" as P4
rectangle "T-15..T-18, T-42" as P6
MED --> CU1
MED --> CU3
ENF --> CU3
ENF --> CU5
MED --> CU5
CU1 --> RF1
CU3 --> RF4
CU5 --> RF6
RF1 --> D1
RF4 --> D4
RF6 --> D6
D1 --> REP
D6 --> REP
D1 --> API1
D4 --> API4
D6 --> API6
API1 --> P1
API4 --> P4
API6 --> P6
REP --> P1 : T-25..T-34
@enduml
