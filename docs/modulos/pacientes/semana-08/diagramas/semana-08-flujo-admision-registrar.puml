@startuml semana-08-flujo-admision-registrar
title User flow · Admisión — buscar antes de registrar (pacientes.buscar · pacientes.registrar)
skinparam ActivityBackgroundColor #F5F9FF
skinparam ActivityBorderColor #2F5D8A
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam defaultFontSize 12

|Admisión|
start
:Inicia sesión y elige hospital
(el hospital activo se ve siempre en la cabecera);
:Abre «Pacientes» · W1;
|Interfaz|
:INICIO «Busca por código, documento
o al menos 3 letras del nombre» · W1;
|Admisión|
:Busca por documento (o por nombre y fecha);
|Interfaz|
if (¿Criterio suficiente? (cliente, misma regla que el servidor)) then (no)
  :M-02 junto al buscador
  (ayuda: qué criterios sirven);
  detach
else (sí)
endif
:CARGA (filas esqueleto, botón deshabilitado);
if (¿Resultado?) then (encontrado)
  :Lista de resultados · W1
  (datos mínimos, documento enmascarado);
  :Abre la ficha existente · W4
  (no registra un duplicado);
  stop
elseif (sin resultados) then (VACÍO)
  :«No encontramos pacientes con esos datos»
  + [Registrar paciente nuevo] · M-03;
else (503)
  :ERROR RECUPERABLE M-12 · [Reintentar] ·
  conserva los criterios;
  detach
endif
|Admisión|
:Pulsa «Registrar paciente nuevo»:
el formulario llega con lo ya buscado · W2;
:Completa datos y documento
(o marca «Sin documento» = identidad provisional);
|Interfaz|
if (¿Formato válido?) then (no)
  :Errores junto a cada campo · M-04..M-07
  conserva lo escrito;
  detach
else (sí)
endif
|Servidor Pacientes|
:POST /api/v1/pacientes
con Idempotency-Key (una por intento);
|Interfaz|
if (¿Resultado?) then (201)
  :ÉXITO «Paciente registrado · P-000123» · M-20
  [Abrir ficha] · foco en el aviso;
  stop
elseif (409 PACIENTE_EXISTENTE) then (bloqueo)
  :W3 «Ya existe un paciente con ese documento»
  [Abrir ficha P-…] (o «Reservado») · M-08;
  stop
elseif (409 POSIBLE_DUPLICADO) then (advertencia)
  :W3 lista de candidatos
  admisión: [Abrir candidato] o [Pedir a un supervisor] · M-09;
  stop
elseif (422 · 400) then (recuperable)
  :Mensaje junto al campo · M-04..M-07
  conserva lo escrito;
  detach
else (red / 503)
  :M-13 «No sabemos si se guardó» · [Reintentar] ·
  (misma Idempotency-Key: no duplica);
  detach
endif
@enduml
