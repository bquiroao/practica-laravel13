@startuml semana-06-trazabilidad
title Semana 6 — Hilo trazable de «consolidar ocupación» con el cambio de procedencia (R-04)
left to right direction
skinparam shadowing false
skinparam defaultFontSize 11
actor "Temporizador\n(S1, CU-01 con CU-04)" as T0
actor "Jefatura de enfermería\n(S1, CU-02 y CU-03)" as J
rectangle "Requisitos" {
  card "RF-01 a RF-06\nR-01 a R-09 (S1-S2)" as RF
  card "R-04 / RF-03: ocupada = exactamente\nuna estancia abierta; dos estancias\nson dos pacientes (H-03 de la S13)" as R4 #FFF3CD
}
rectangle "Contrato API (S5)" {
  card "POST /ocupacion/cortes  201 | 503 E8\nGET /ocupacion[?estado=]  200 | 422 E3 | 503 E8\n(sin cambios: inconsistentes ya existía)" as API
}
rectangle "Micro-HIS por capas (S3-S4)" {
  component "Presentación\nRutas -> ControladorOcupacion\nVistaJson" as P
  component "Aplicación\nConsolidadorOcupacion, ConsultaOcupacion\npuertos FuenteCamas, EscritorCortes,\nLectorCortes (ISP)" as AP
  component "Dominio\nOcupacionSala::calcular\n(estancias !== 1 o 0 -> inconsistente)" as D #FFF3CD
  component "Persistencia\nRepositorioPdo: COUNT(*) de bed_stays\nRepositorioEnMemoria: estancias (int)" as PE #FFF3CD
}
database "beds\nbed_stays" as DB
card "Pruebas: 31 de 31\nS13: H-03 no reproducido" as TS
T0 --> RF
J --> RF
RF --> R4
R4 --> API
API --> P
P --> AP
AP --> D
AP --> PE
PE --> DB
D ..> TS : verifica
PE ..> TS : verifica
@enduml
