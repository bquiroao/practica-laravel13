APP_NAME="Hospital HIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=hospital
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=his_central
CENTRAL_DB_USERNAME=postgres
CENTRAL_DB_PASSWORD=
HOSPITAL_DB_HOST=127.0.0.1
HOSPITAL_DB_PORT=5432
HOSPITAL_DB_DATABASE=his_hospital
HOSPITAL_DB_USERNAME=postgres
HOSPITAL_DB_PASSWORD=

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# URL absoluta del API si el frontend Vite corre en otro origen (desarrollo típico):
# Solo si la API está en otro origen (por defecto la SPA usa /api/v1 del mismo servidor).
# VITE_API_URL=https://api.ejemplo.test/api/v1

# Token con el que el CI registra sus ejecuciones en Calidad (POST /api/v1/calidad/ci/ejecuciones). Vacío = deshabilitado.
NIDO_CI_TOKEN=
